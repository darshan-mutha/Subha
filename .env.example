# Claude API key from https://platform.claude.com (Settings > API keys). Server only.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-sonnet-5-5)
CLAUDE_MODEL=
# Optional cost guards: AI requests per visitor per day (default 50), for the whole app per hour (default 300)
AI_DAILY_LIMIT_PER_VISITOR=
AI_HOURLY_LIMIT_TOTAL=
# Optional: set to 1 to pause AI planning instantly
AI_DISABLED=
# Neon Postgres connection string (Vercel > Storage > Neon sets this for you). Needed for team sharing.
DATABASE_URL=
